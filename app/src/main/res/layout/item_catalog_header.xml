<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:theme="@style/Theme.CineStream"
    tools:context=".MainActivity"
    tools:background="@color/background">

    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="400dp"
        android:layout_margin="6dp"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            tools:src="@drawable/poster_placeholder" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_shade" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="400dp"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                style="@style/CineText"
                android:layout_width="wrap_content"
                android:text="@string/spotlight_badge"
                android:background="@drawable/bg_badge"
                android:padding="8dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/rating"
                android:layout_marginTop="110dp" />

            <TextView
                android:id="@+id/hero_title"
                style="@style/CineText"
                android:layout_marginTop="14dp"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="Midnight Atlas" />

            <TextView
                android:id="@+id/hero_meta"
                style="@style/CineText"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="#D4D8E1"
                tools:text="TV SERIES · 2026 · ★ 8.4" />

            <TextView
                android:id="@+id/hero_overview"
                style="@style/CineText"
                android:layout_marginTop="10dp"
                android:textColor="#C2C8D5"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                tools:text="One unexpected journey. A city full of secrets. Find your next great story." />

            <Button
                android:id="@+id/watch_button"
                style="@style/CineButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_accent"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:text="@string/watch_now" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:orientation="vertical">

        <TextView
            style="@style/CineText"
            android:text="@string/front_row"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent"
            android:letterSpacing="0.16" />

        <TextView
            android:id="@+id/heading"
            style="@style/CineText"
            android:layout_marginTop="8dp"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black"
            android:accessibilityHeading="true"
            tools:text="Worth watching" />

        <TextView
            android:id="@+id/count"
            style="@style/CineText"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            tools:text="24 titles · picked for your screen" />

        <TextView
            android:id="@+id/notice"
            style="@style/CineText"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            tools:visibility="gone" />

        <LinearLayout
            android:id="@+id/state_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="28dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card"
            tools:visibility="gone">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="18dp"
                android:contentDescription="@string/loading" />

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_movies"
                android:tint="@color/accent"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/state_title"
                style="@style/CineText"
                android:gravity="center"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/status"
                style="@style/CineText"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:accessibilityLiveRegion="polite" />

            <Button
                android:id="@+id/retry_button"
                style="@style/CineButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_accent"
                android:text="@string/retry" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
